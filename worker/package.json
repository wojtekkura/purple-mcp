{
  "name": "purple-mcp-worker",
  "version": "0.1.0",
  "description": "Remote SentinelOne / Purple AI MCP server (Workers port of the Python purple-mcp). Per-user auth, D1 audit, SIEM fan-out — same architecture as cf-mcp.",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "d1:migrate:local": "wrangler d1 execute purple_mcp_audit --local --file=./schema/audit.sql",
    "d1:migrate:remote": "wrangler d1 execute purple_mcp_audit --remote --file=./schema/audit.sql"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20250601.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.0.0"
  }
}
